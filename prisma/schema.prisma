generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MtoEntry {
  id        String   @id @default(cuid())
  productId String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, createdAt])
}

model MtoSystemInventory {
  id        String   @id
  quantity  Float
  updatedAt DateTime @updatedAt
}
